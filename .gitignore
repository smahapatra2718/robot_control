# Python venv — regenerable from uv.lock, machine-specific (see README "Setup")
.venv/

# Legacy pre-uv venv. Safe to delete: `rm -rf robot_control/`
robot_control/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Lab credentials (PC / WSL / UR pendant logins). This repo is PUBLIC — these stay
# on the lab machine only. presentation.html points at this file rather than quoting it.
important_notes.txt

# Photo/screenshot sources for presentation.html are tracked (via Git LFS, see
# .gitattributes). The deck embeds its own copies through scripts/embed_images.py
# so it stays self-contained, but the originals are kept so slots can be re-baked
# on any machine after a re-crop or a re-shoot.
